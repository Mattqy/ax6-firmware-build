# 红米 AX6 原厂分区(stock) 极简纯净配置 (无代理 / 无第三方主题)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y

# ── DNS 处理 (保留轻量级 SmartDNS) ───────────────────────────
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_smartdns=y

# ── 多功能万能工具 (保留 Lucky，整合 DDNS/反代/WOL) ─────────
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y

# ── LuCI 基础与官方原生主题 ──────────────────────────────────
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-sqm=y

# ── 中文语言包 ────────────────────────────────────────────────
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ── PPPoE 拨号支持 ────────────────────────────────────────────
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ── 基础工具 ──────────────────────────────────────────────────
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

# ── IPv6 支持 ─────────────────────────────────────────────────
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ── WireGuard 组网 ────────────────────────────────────────────
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# ── NSS 核心驱动与控制服务 ───────────────────────────────────────
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-mcs=y

# ── Wi-Fi NSS 硬件加速驱动 (ath11k NSS Offload) ────────────────
CONFIG_PACKAGE_kmod-ath11k-nss=y
CONFIG_ATH11K_NSS_SUPPORT=y

# ── NSS 状态监控与 LuCI 界面 ──────────────────────────────────
CONFIG_PACKAGE_nss-status=y
CONFIG_PACKAGE_luci-app-nss-status=y

# ── 显式禁用的冗余组件与主题 ──────────────────────────────────
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_nano is not set
